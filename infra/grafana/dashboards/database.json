{
  "id": null,
  "uid": "payvia-database",
  "title": "Payvia — PostgreSQL",
  "tags": ["payvia", "database"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Conexiones activas", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "sesiones", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "Conexiones por base de datos", "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "Transacciones por segundo", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit {{datname}}", "refId": "A" }, { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback {{datname}}", "refId": "B" }] },
    { "id": 4, "type": "timeseries", "title": "Cache hit ratio", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(pg_stat_database_blks_hit) / clamp_min(sum(pg_stat_database_blks_hit + pg_stat_database_blks_read), 1)", "legendFormat": "cache hit", "refId": "A" }] }
  ]
}
