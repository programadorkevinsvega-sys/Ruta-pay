vault {
  address = "https://vault.example.invalid:8200"
}

auto_auth {
  method "approle" {
    mount_path = "auth/approle"
    config = {
      role_id_file_path                   = "/etc/vault/agent/role_id"
      secret_id_file_path                 = "/etc/vault/agent/secret_id"
      secret_id_response_wrapping_path    = "auth/approle/role/app-REPLACE_WITH_SLUG/secret-id"
      remove_secret_id_file_after_reading = true
    }
  }
}

api_proxy {
  use_auto_auth_token = true
}

listener "tcp" {
  address     = "127.0.0.1:8100"
  tls_disable = true
}
