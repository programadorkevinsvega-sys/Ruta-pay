POSTGRES_DB=payvia
POSTGRES_USER=payvia_bootstrap
POSTGRES_PASSWORD_FILE=/etc/payvia/postgres/bootstrap-password
POSTGRES_TLS_DIR=/etc/payvia/postgres/tls
POSTGRES_CLIENT_CA_DIR=/etc/payvia/postgres/client-ca
POSTGRES_SERVER_CA_DIR=/etc/payvia/postgres/server-ca
POSTGRES_EXPORTER_TLS_DIR=/etc/payvia/postgres/exporter-client
POSTGRES_PG_HBA_FILE=/etc/payvia/postgres/pg_hba.conf
POSTGRES_MAX_CONNECTIONS=
POSTGRES_SHARED_BUFFERS=
POSTGRES_EFFECTIVE_CACHE_SIZE=
POSTGRES_WORK_MEM=
POSTGRES_MAINTENANCE_WORK_MEM=
