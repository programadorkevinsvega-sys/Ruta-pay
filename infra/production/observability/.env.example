GRAFANA_ADMIN_USER=REPLACE_WITH_ADMIN_USER
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
GRAFANA_PUBLIC_HOST=REPLACE_WITH_GRAFANA_HTTPS_HOSTNAME
PROMETHEUS_ADMIN_USER=payvia_metrics_admin
PROMETHEUS_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
PROMETHEUS_ADMIN_PASSWORD_FILE=/etc/payvia/observability/prometheus-admin-password
PROMETHEUS_WEB_CONFIG_FILE=/etc/payvia/observability/prometheus-web.yml
PLATFORM_METRICS_TOKEN_FILE=/etc/payvia/observability/platform-metrics-token
PASARELA_METRICS_TOKEN_FILE=/etc/payvia/observability/pasarela-metrics-token
TELEGRAM_BOT_TOKEN_FILE=/etc/payvia/observability/telegram-bot-token
TELEGRAM_CHAT_ID_FILE=/etc/payvia/observability/telegram-chat-id
PROMETHEUS_RETENTION_TIME=15d
