REDIS_MAXMEMORY=512mb
REDIS_HEALTHCHECK_USER=payvia_healthcheck
REDIS_EXPORTER_USER=payvia_exporter
REDIS_TLS_DIR=/etc/payvia/staging/redis/tls
REDIS_CLIENT_CA_DIR=/etc/payvia/staging/redis/client-ca
REDIS_SERVER_CA_DIR=/etc/payvia/staging/redis/server-ca
REDIS_HEALTHCHECK_TLS_DIR=/etc/payvia/staging/redis/healthcheck-client
REDIS_HEALTHCHECK_CREDENTIAL_DIR=/etc/payvia/staging/redis/healthcheck-credentials
REDIS_ACL_DIR=/etc/payvia/staging/redis/acl
REDIS_ROTATION_CREDENTIAL_DIR=/etc/payvia/staging/redis/rotation-credentials
REDIS_EXPORTER_TLS_DIR=/etc/payvia/staging/redis/exporter-client
REDIS_EXPORTER_CREDENTIAL_DIR=/etc/payvia/staging/redis/exporter-credentials
