POSTGRES_DB=payvia
POSTGRES_USER=payvia_bootstrap
POSTGRES_PASSWORD_FILE=/etc/payvia/staging/postgres/bootstrap-password
POSTGRES_EXPORTER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PLATFORM_MIGRATOR_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PLATFORM_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
