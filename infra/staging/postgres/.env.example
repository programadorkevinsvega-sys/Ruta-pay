POSTGRES_DB=payvia
POSTGRES_USER=payvia_bootstrap
POSTGRES_PASSWORD_FILE=/etc/payvia/staging/postgres/bootstrap-password
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_PG_HBA_FILE=/etc/payvia/staging/postgres/pg_hba.conf
POSTGRES_TLS_DIR=/etc/payvia/staging/postgres/tls
POSTGRES_CLIENT_CA_DIR=/etc/payvia/staging/postgres/client-ca
POSTGRES_SERVER_CA_DIR=/etc/payvia/staging/postgres/server-ca
POSTGRES_EXPORTER_TLS_DIR=/etc/payvia/staging/postgres/exporter-tls
