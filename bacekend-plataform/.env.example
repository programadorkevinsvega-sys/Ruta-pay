# Plantilla de producción para bacekend-plataform.
# Completa todos los valores obligatorios con secretos del entorno antes de desplegar.
# Instala este archivo como bacekend-plataform/.env con permisos 0600; nunca lo subas a Git.

RUST_LOG=info
APP_ENV=production
APP_VERSION=REPLACE_WITH_RELEASE_VERSION
APP_HTTP_ADDR=0.0.0.0:18080
APP_MODULE_GRPC_ADDR=127.0.0.1:15051
APP_METRICS_ADDR=192.0.2.70:19090
# Genera al menos 32 caracteres aleatorios; Prometheus debe usar el mismo valor.
APP_METRICS_BEARER_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS

# URLs e identidades independientes de PostgreSQL, Redis y NATS.
# PostgreSQL requiere TLS verificado y certificado de cliente.
PLATFORM_DATABASE_URL=postgres://REPLACE_WITH_RUNTIME_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@192.0.2.142:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/etc/payvia/pg-ca.pem&sslcert=/etc/payvia/pg-rt.crt&sslkey=/etc/payvia/pg-rt.key
# Redis exige rediss://, certificado cliente validado por Redis y ACL.
PLATFORM_REDIS_TLS_ROOT_CA=/etc/payvia/redis-ca.pem
PLATFORM_REDIS_TLS_CLIENT_CERT=/etc/payvia/redis-platform-client.crt
PLATFORM_REDIS_TLS_CLIENT_KEY=/etc/payvia/redis-platform-client.key
PLATFORM_REDIS_URL=rediss://REPLACE_WITH_PLATFORM_REDIS_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@192.0.2.65:6379/0
PLATFORM_NATS_URL=tls://192.0.2.97:4222
# El SAN DNS del certificado debe coincidir con el usuario NATS autorizado para plataforma.
NATS_TLS_ROOT_CA=/etc/payvia/nats-ca.pem
NATS_TLS_CLIENT_CERT=/etc/payvia/nats-platform-client.crt
NATS_TLS_CLIENT_KEY=/etc/payvia/nats-platform-client.key
PAYVIA_REQUIRE_MTLS=true

# Límites de pool de PostgreSQL; deben dimensionarse junto a todas las réplicas.
PLATFORM_DATABASE_MIN_CONNECTIONS=2
PLATFORM_DATABASE_MAX_CONNECTIONS=8
# Opcional: 1..=MAX_BATCH_SIZE. Si no se configura, se usa el valor por defecto del servicio.
# PLATFORM_BILLING_USAGE_BATCH_SIZE=
# No definir en producción: el namespace ausente selecciona el stream productivo.
# PLATFORM_EVENT_NAMESPACE=

# Claves HMAC Base64, cada una de al menos 32 bytes antes de codificar.
# La clave e ID de solicitud deben coincidir con GATEWAY_PLATFORM_REQUEST_VERIFY_KEY[_ID].
PLATFORM_GATEWAY_REQUEST_SIGNING_KEY=
PLATFORM_GATEWAY_REQUEST_SIGNING_KEY_ID=
# La clave e ID de eventos deben coincidir con GATEWAY_EVENT_SIGNING_KEY[_ID].
PLATFORM_GATEWAY_EVENT_VERIFY_KEY=
PLATFORM_GATEWAY_EVENT_VERIFY_KEY_ID=

# Solo para ejecutar migrate-platform; usa un rol distinto al runtime.
PLATFORM_MIGRATION_DATABASE_URL=postgres://REPLACE_WITH_MIGRATION_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@192.0.2.142:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/etc/payvia/pg-ca.pem&sslcert=/etc/payvia/pg-mig.crt&sslkey=/etc/payvia/pg-mig.key
PLATFORM_RUNTIME_DB_ROLE=REPLACE_WITH_RUNTIME_DB_ROLE

# Collector local a la VM de aplicaciones. Mantén OTLP enlazado a loopback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Observabilidad remota opcional según la topología del entorno.
# El DSN de Sentry de plataforma es independiente del de pasarelas.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
