# Plantilla de producción para bacekend-pasarela.
# Completa todos los valores obligatorios con secretos del entorno antes de desplegar.
# Instala este archivo como bacekend-pasarela/.env con permisos 0600; nunca lo subas a Git.

RUST_LOG=info
GATEWAY_ENV=production
GATEWAY_VERSION=REPLACE_WITH_RELEASE_VERSION
GATEWAY_HTTP_ADDR=0.0.0.0:18081
GATEWAY_METRICS_ADDR=192.0.2.70:19091
# Genera al menos 32 caracteres aleatorios; Prometheus debe usar el mismo valor.
PASARELA_METRICS_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS

# JSON de cuentas Wompi reales del entorno. Cada objeto contiene account_reference, tenant_id,
# environment, event_secret y private_key. Proporciona el JSON completo en una sola línea
# mediante el gestor de secretos; no uses cuentas ni credenciales de ejemplo.
GATEWAY_WOMPI_ACCOUNTS_JSON=

# Claves HMAC Base64, cada una de al menos 32 bytes antes de codificar.
# La clave e ID de evento deben coincidir con PLATFORM_GATEWAY_EVENT_VERIFY_KEY[_ID].
GATEWAY_EVENT_SIGNING_KEY=
GATEWAY_EVENT_SIGNING_KEY_ID=
# La clave e ID de solicitud deben coincidir con PLATFORM_GATEWAY_REQUEST_SIGNING_KEY[_ID].
GATEWAY_PLATFORM_REQUEST_VERIFY_KEY=
GATEWAY_PLATFORM_REQUEST_VERIFY_KEY_ID=

# NATS privado con autenticación y mTLS.
GATEWAY_NATS_URL=tls://192.0.2.97:4222
# El SAN DNS del certificado debe coincidir con el usuario NATS autorizado para pasarela.
NATS_TLS_ROOT_CA=/etc/payvia/nats-ca.pem
NATS_TLS_CLIENT_CERT=/etc/payvia/nats-gateway-client.crt
NATS_TLS_CLIENT_KEY=/etc/payvia/nats-gateway-client.key
PAYVIA_REQUIRE_MTLS=true

# Collector local a la VM de aplicaciones. Mantén OTLP enlazado a loopback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Observabilidad remota opcional según la topología del entorno.
# El DSN de Sentry de pasarelas es independiente del de plataforma.
# GATEWAY_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
